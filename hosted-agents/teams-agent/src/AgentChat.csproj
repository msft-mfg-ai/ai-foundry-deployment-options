<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentChat</RootNamespace>
    <Version>0.9.1</Version>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <UserSecretsId>8a57129c-85e4-456e-9f62-2442aad32909</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.62.0" />
    <PackageReference Include="Azure.AI.AgentServer.Invocations" Version="1.0.0-beta.5" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.20.0-preview.260831.1" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.12.0-preview.260629.1" />
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" Version="1.6.150" />
    <PackageReference Include="Microsoft.Agents.Builder" Version="1.6.150" />
    <PackageReference Include="Microsoft.Agents.Connector" Version="1.6.150" />
    <PackageReference Include="Microsoft.Agents.Core" Version="1.6.150" />
    <PackageReference Include="Microsoft.Agents.Extensions.Teams" Version="1.6.150" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" Version="1.6.150" />
    <PackageReference Include="Microsoft.Agents.Storage.CosmosDb" Version="1.6.150" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.10.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.10.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.84.2" />
    <PackageReference Include="AdaptiveCards" Version="3.1.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentChat.Tests" />
  </ItemGroup>

  <Target Name="BuildTeamsTab" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipTeamsTabBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm run build -- --outDir dist" />
    <ItemGroup>
      <TeamsTabDist Include="$(MSBuildProjectDirectory)/ClientApp/dist/**/*" />
      <ResolvedFileToPublish Include="@(TeamsTabDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/teams-chat/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
