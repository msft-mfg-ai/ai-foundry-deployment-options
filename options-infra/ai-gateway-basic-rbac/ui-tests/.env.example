# User identity we are testing as. Free-form label used in evidence rows.
UI_USER_LABEL=SimpleJoe

# Foundry portal (project-scoped URL is derived from the values in ../tests/.env).
FOUNDRY_PORTAL_HOME=https://ai.azure.com/

# Optional override — full deep link to Joe's project. If empty, the harness
# builds it from AZURE_SUBSCRIPTION_ID/RESOURCE_GROUP/FOUNDRY_PROJECT_NAME
# read out of ../tests/.env at test time.
FOUNDRY_PROJECT_URL=

# Where auth state is stored after auth_setup.py. Do NOT commit.
STORAGE_STATE_PATH=.auth/joe.json
